# Local CLI credentials/configuration are never frontend assets.
.env*
**/.env*
.vercel/
**/.vercel/**
.git/
**/.git/**

# Keep native simulator archives, commercial licenses and private keys local.
**/*.[bB][kK][pP]
**/*.[aA][pP][wW]
**/*.[aA][pP][wW][zZ]
**/*.[lL][iI][cC]
**/*.[pP][eE][mM]
**/*.[kK][eE][yY]
**/*.[pP][fF][xX]
**/*.[pP]12

# Open-source notices in vendor/LICENSE-*.txt remain included.

# Huge brand/plant originals live in ../brand-archive (outside this deploy root).
# Guard against accidental reintroduction under assets/.
assets/brand/*.png
!assets/brand/logo-01-icon.png
assets/process-skid.png
assets/exchanger.png
assets/heater.png
