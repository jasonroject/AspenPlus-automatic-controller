{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "aspen-study/2/advice.schema.json",
 "title": "aspen-advice/1：对一个已体检模型的规则建议",
 "description": "由 aspen_study.advice（Python）或 analysis_web/aspen-advice.mjs（浏览器）生成，规则表共用 analysis_web/data/aspen-advice-rules.json；输出确定性（无时间戳）。severity：critical > warn > suggest > info。confidence：verified = 结论直接来自探针字段或消息原文；heuristic = 含阈值或经验推断。evidence[].path 是 JSON Pointer（文件名#路径），指向升级到 aspen-probe/1.1 之后的视图。不含排放因子，不编造数值。",
 "type": "object",
 "required": [
  "schema",
  "rules_version",
  "model",
  "inputs",
  "counts",
  "items",
  "skipped"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "aspen-advice/1"
  },
  "rules_version": {
   "type": "string"
  },
  "model": {
   "type": "object",
   "required": [
    "file",
    "sha256"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    }
   }
  },
  "inputs": {
   "type": "object",
   "required": [
    "probe",
    "graph",
    "roles"
   ],
   "properties": {
    "probe": {
     "type": "string"
    },
    "migrated_from": {
     "type": [
      "string",
      "null"
     ]
    },
    "graph": {
     "type": "boolean"
    },
    "roles": {
     "type": "boolean"
    }
   }
  },
  "counts": {
   "type": "object",
   "required": [
    "critical",
    "warn",
    "suggest",
    "info",
    "total"
   ],
   "properties": {
    "critical": {
     "type": "integer"
    },
    "warn": {
     "type": "integer"
    },
    "suggest": {
     "type": "integer"
    },
    "info": {
     "type": "integer"
    },
    "total": {
     "type": "integer"
    }
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "rule",
     "severity",
     "category",
     "target",
     "title_zh",
     "detail_zh",
     "evidence",
     "action_zh",
     "confidence"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "rule": {
      "type": "string",
      "minLength": 1
     },
     "severity": {
      "enum": [
       "critical",
       "warn",
       "suggest",
       "info"
      ]
     },
     "category": {
      "enum": [
       "convergence",
       "thermo/phase",
       "reaction",
       "units",
       "energy",
       "heat-integration",
       "data-completeness",
       "lca-readiness"
      ]
     },
     "target": {
      "type": "string",
      "minLength": 1,
      "description": "块名或流股名（与 graph.json 的节点 id 一致），整体问题为 'global'"
     },
     "title_zh": {
      "type": "string",
      "minLength": 1
     },
     "detail_zh": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path",
        "value"
       ],
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^(probe-summary|graph|roles)\\.json#/"
        },
        "value": {},
        "unit": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       }
      }
     },
     "action_zh": {
      "type": "string",
      "minLength": 1
     },
     "confidence": {
      "enum": [
       "verified",
       "heuristic"
      ]
     }
    }
   }
  },
  "skipped": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "rule",
     "reason_zh"
    ],
    "properties": {
     "rule": {
      "type": "string"
     },
     "reason_zh": {
      "type": "string"
     },
     "missing_inputs": {
      "type": "array",
      "items": {
       "enum": [
        "graph",
        "roles"
       ]
      }
     }
    }
   }
  }
 }
}
