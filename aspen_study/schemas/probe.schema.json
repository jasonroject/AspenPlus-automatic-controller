{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "aspen-study/2/probe.schema.json",
 "title": "aspen-probe/1.1：单个模型的一键体检结果（运行状态 + 逐块能量表）",
 "description": "energy[].value/unit 是节点原生值与 UnitString；kW 是换算结果，换算不了为 null（绝不补 0）。status.state：ok / warning / error。1.1 相对 1.0：块消息拆为 blkmsg + per_error；energy_gaps 与顶层 unverified_paths 是 {block,path,reason} 对象；能量项带 verified；新增 group_totals；totals_complete 必有。读 1.0 文件请先用 aspen_study.probe_compat.upgrade_summary 升级（analysis_web 里同名逻辑）。advice 不在本文件里，单独成 advice.json（aspen-advice/1）。",
 "type": "object",
 "required": [
  "schema",
  "model",
  "status",
  "units",
  "calorie_J",
  "blocks",
  "totals_kW",
  "totals_complete",
  "group_totals",
  "energy_gaps",
  "unverified_paths",
  "discovery",
  "cleanup"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "aspen-probe/1.1"
  },
  "created": {
   "type": "string"
  },
  "elapsed_seconds": {
   "type": "number"
  },
  "model": {
   "type": "object",
   "required": [
    "file",
    "sha256",
    "simulator",
    "source_unchanged"
   ],
   "properties": {
    "file": {
     "type": "string",
     "minLength": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "simulator": {
     "type": "string"
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    },
    "progid": {
     "type": "string"
    },
    "adapter": {
     "type": "string"
    },
    "source_unchanged": {
     "type": [
      "boolean",
      "null"
     ]
    }
   }
  },
  "status": {
   "type": "object",
   "required": [
    "state",
    "run_completed",
    "errors",
    "warnings",
    "notes"
   ],
   "properties": {
    "state": {
     "enum": [
      "ok",
      "warning",
      "error"
     ]
    },
    "run_completed": {
     "type": "boolean"
    },
    "errors": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "raw_status": {
     "type": "object"
    },
    "run_status_lines": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "run_seconds": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "units": {
   "type": "object"
  },
  "calorie_J": {
   "type": "number"
  },
  "blocks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "status",
     "blkstat",
     "blkmsg",
     "per_error",
     "energy"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "warning",
       "error",
       "unknown"
      ]
     },
     "blkstat": {
      "type": [
       "integer",
       "null"
      ]
     },
     "outlet_temperature": {
      "type": "object"
     },
     "energy": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "kind",
        "value",
        "unit",
        "kW",
        "verified"
       ],
       "properties": {
        "kind": {
         "enum": [
          "heat",
          "work"
         ]
        },
        "role_hint": {
         "type": "string"
        },
        "value": {
         "type": "number"
        },
        "unit": {
         "type": "string"
        },
        "kW": {
         "type": [
          "number",
          "null"
         ]
        },
        "note": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "explicit_zero": {
         "type": "boolean"
        },
        "verified": {
         "type": "boolean"
        }
       }
      }
     },
     "blkmsg": {
      "type": [
       "string",
       "null"
      ]
     },
     "per_error": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "per_error_total": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0
     }
    }
   }
  },
  "totals_kW": {
   "type": "object",
   "properties": {
    "heating": {
     "type": [
      "number",
      "null"
     ]
    },
    "cooling": {
     "type": [
      "number",
      "null"
     ]
    },
    "work": {
     "type": [
      "number",
      "null"
     ]
    },
    "internal_exchange": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "totals_complete": {
   "type": "boolean"
  },
  "energy_gaps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "block",
     "path",
     "reason"
    ],
    "properties": {
     "block": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  "discovery": {
   "type": "object"
  },
  "cleanup": {
   "type": "object"
  },
  "study": {
   "type": "object"
  },
  "migrated_from": {
   "const": "aspen-probe/1"
  },
  "group_totals": {
   "type": "object",
   "required": [
    "heating",
    "cooling",
    "shaft_work",
    "internal_exchange",
    "overall"
   ],
   "additionalProperties": false,
   "properties": {
    "heating": {
     "type": "object",
     "required": [
      "kW",
      "complete"
     ],
     "additionalProperties": false,
     "properties": {
      "kW": {
       "type": [
        "number",
        "null"
       ]
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "cooling": {
     "type": "object",
     "required": [
      "kW",
      "complete"
     ],
     "additionalProperties": false,
     "properties": {
      "kW": {
       "type": [
        "number",
        "null"
       ]
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "shaft_work": {
     "type": "object",
     "required": [
      "kW",
      "complete"
     ],
     "additionalProperties": false,
     "properties": {
      "kW": {
       "type": [
        "number",
        "null"
       ]
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "internal_exchange": {
     "type": "object",
     "required": [
      "kW",
      "complete"
     ],
     "additionalProperties": false,
     "properties": {
      "kW": {
       "type": [
        "number",
        "null"
       ]
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "overall": {
     "type": "object",
     "required": [
      "kW",
      "complete"
     ],
     "additionalProperties": false,
     "properties": {
      "kW": {
       "type": [
        "number",
        "null"
       ]
      },
      "complete": {
       "type": "boolean"
      }
     }
    }
   },
   "description": "kW；任一成员为 null 则该类 kW 为 null 且 complete=false。internal_exchange 是换热器内部换热，不计入外购；overall = heating + cooling（负值）+ shaft_work 的带符号净值（不含 internal_exchange），不是总能耗。totals_complete=false 时所有 complete 为 false。"
  },
  "unverified_paths": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "block",
     "path",
     "reason"
    ],
    "properties": {
     "block": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    }
   }
  }
 }
}